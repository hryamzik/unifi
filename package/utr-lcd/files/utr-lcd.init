#!/bin/sh /etc/rc.common
# LCD status display for the UniFi Travel Router (long-range)

USE_PROCD=1
START=95
STOP=10

LIBEXEC=/usr/libexec/utr-lcd
STOCK=/usr/share/utr-lcd/stock
RUN=/var/run/utr-lcd
BL=/sys/class/backlight/backlight

set_brightness() {
	local pct=$1 max
	[ -n "$pct" ] && [ -w "$BL/brightness" ] || return 0
	max=$(cat "$BL/max_brightness" 2>/dev/null) || return 0
	case "$pct" in *[!0-9]*) return 0 ;; esac
	[ "$pct" -lt 1 ] && pct=1
	[ "$pct" -gt 100 ] && pct=100
	echo $((max * pct / 100)) > "$BL/brightness"
}

# Flatten the screen layout from UCI into a key=value file for the built-in renderer.
# Widgets that need the traffic sampler (traffic.sh); it only runs while a screen that is shown uses one.
TRAFFIC_WANTED=0
SCREEN_NO=0
SCREEN_SHOWN=0
screen_widget() {
	echo "widget=$1"
	case "$1" in *speed*|*usage*|*legend*|*donut*) [ "$SCREEN_SHOWN" = 1 ] && TRAFFIC_WANTED=1 ;; esac
}

screen_section() {
	local name dwell enabled indicator backfill spacing
	SCREEN_NO=$((SCREEN_NO + 1))
	SCREEN_SHOWN=0
	config_get_bool enabled "$1" enabled 1
	if [ "$WL_MODE" = pin ]; then
		[ "$SCREEN_NO" = "$WL_PIN" ] && SCREEN_SHOWN=1
	elif [ -n "$WL_PLAYLIST" ]; then
		case " $WL_PLAYLIST " in *" $SCREEN_NO "*) [ "$enabled" = 1 ] && SCREEN_SHOWN=1 ;; esac
	else
		[ "$enabled" = 1 ] && SCREEN_SHOWN=1
	fi
	config_get name      "$1" name "Screen"
	config_get dwell     "$1" dwell 8
	config_get_bool enabled "$1" enabled 1
	config_get indicator "$1" indicator none
	config_get_bool backfill "$1" backfill 1
	config_get spacing   "$1" spacing auto
	printf 'screen=%s\n' "$(echo "$name" | head -n 1)"
	echo "dwell=$dwell"
	echo "spacing=$spacing"
	echo "enabled=$enabled"
	echo "indicator=$indicator"
	echo "backfill=$backfill"
	config_list_foreach "$1" widget screen_widget
}

write_screens() {
	local smode spin playlist fdim fedge nlen
	config_get smode    main screen_mode rotate
	config_get spin     main screen_pin 1
	config_get playlist main playlist ''
	config_get fdim     main fill_dim 30
	config_get fedge    main fill_edge 1
	config_get nlen     main name_len 8
	WL_MODE=$smode; WL_PIN=$spin; WL_PLAYLIST=$(echo "$playlist" | tr ',' ' ')
	TRAFFIC_WANTED=0; SCREEN_NO=0
	{
		echo "mode=$smode"
		echo "pin=$spin"
		echo "playlist=$playlist"
		echo "fill_dim=$fdim"
		echo "fill_edge=$fedge"
		echo "name_len=$nlen"
		config_foreach screen_section screen
	} > "$RUN/screens.conf.new" && mv "$RUN/screens.conf.new" "$RUN/screens.conf"
	# no screen sections: the renderer's built-in screens apply, and they include traffic
	[ "$SCREEN_NO" = 0 ] && TRAFFIC_WANTED=1
}

start_service() {
	local enabled mode interval rotate brightness theme ox oy dim_after dim_level off_after motion odr rot_flag=""

	config_load utr-lcd
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get mode       main mode auto
	config_get interval   main interval 3
	config_get rotate     main rotate 180
	config_get brightness main brightness ''
	config_get theme      main theme blue
	config_get ox         main offset_x 0
	config_get oy         main offset_y 0
	config_get dim_after  main dim_after 0
	config_get dim_level  main dim_level 15
	config_get off_after  main screen_timeout 0
	config_get motion     main motion_threshold 50
	config_get odr        main sensor_rate 25

	[ -e /dev/dri/card0 ] || { logger -t utr-lcd "no /dev/dri/card0 (LCD panel driver missing?)"; return 1; }
	[ "$rotate" = 0 ] && rot_flag="-0"

	mkdir -p "$RUN"
	set_brightness "$brightness"
	# a restart must never leave the panel dark (the power manager may have turned it off)
	[ "$(cat $BL/brightness 2>/dev/null)" = 0 ] && cat "$BL/max_brightness" > "$BL/brightness" 2>/dev/null

	[ "$mode" = auto ] && mode=stock
	if [ "$mode" = stock ] && [ ! -x "$STOCK/bin/ulcmd" ]; then
		# bundle not installed: the built-in renderer needs nothing else, so use it
		logger -t utr-lcd "stock bundle not installed, using the built-in renderer"
		mode=native
	fi

	if [ "$mode" = stock ]; then
		rm -f /var/run/ubus.sock

		procd_open_instance ubusd
		procd_set_param command /sbin/ubusd -s /var/run/ubus.sock
		procd_set_param respawn 3600 5 0
		procd_close_instance

		procd_open_instance ulcmd
		procd_set_param command $LIBEXEC/stock-run.sh
		procd_set_param env UTR_STOCK=$STOCK UTR_RUN=$RUN
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param respawn 3600 5 0
		procd_close_instance

		procd_open_instance fb2drm
		procd_set_param command /usr/bin/utr-lcd-fb2drm -f $RUN/fb0.raw -x "$ox" -y "$oy" $rot_flag
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param respawn 3600 5 0
		procd_close_instance

		procd_open_instance feed
		procd_set_param command $LIBEXEC/feed.sh
		procd_set_param env UTR_RUN=$RUN UTR_LIBEXEC=$LIBEXEC UTR_THEME=$theme UTR_INTERVAL=$interval UTR_BRIGHTNESS=$brightness
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param respawn 3600 5 0
		procd_close_instance

	else
		write_screens
		if [ "$TRAFFIC_WANTED" = 1 ]; then
			rm -f "$RUN/traffic"
			procd_open_instance traffic
			procd_set_param command $LIBEXEC/traffic.sh
			procd_set_param env UTR_RUN=$RUN
			procd_set_param respawn 3600 5 0
			procd_close_instance
		fi
		procd_open_instance native
		procd_set_param command /usr/bin/utr-lcd-status -c $LIBEXEC/collect.sh -C $RUN/screens.conf -T $RUN/traffic -i "$interval" $rot_flag
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param respawn 3600 5 0
		procd_close_instance
	fi

	# dim / blank on idle, wake on motion (both modes; only touches the backlight)
	if [ "$dim_after" -gt 0 ] 2>/dev/null || [ "$off_after" -gt 0 ] 2>/dev/null; then
		local full=$brightness
		[ -n "$full" ] || { [ "$mode" = stock ] && full=80 || full=100; }   # the stock UI starts at 80
		procd_open_instance power
		procd_set_param command $LIBEXEC/power.sh
		procd_set_param env UTR_RUN=$RUN UTR_FULL=$full UTR_DIM_AFTER=$dim_after \
			UTR_DIM_LEVEL=$dim_level UTR_OFF_AFTER=$off_after UTR_WAKE_THR=$motion UTR_ODR=$odr
		procd_set_param respawn 3600 5 0
		procd_close_instance
	fi
}

service_triggers() {
	procd_add_reload_trigger utr-lcd
}
