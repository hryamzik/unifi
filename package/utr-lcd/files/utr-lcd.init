#!/bin/sh /etc/rc.common
# LCD status display for the UniFi Travel Router (long-range)

USE_PROCD=1
START=95
STOP=10

LIBEXEC=/usr/libexec/utr-lcd
STOCK=/usr/share/utr-lcd/stock
RUN=/var/run/utr-lcd
BL=/sys/class/backlight/backlight

set_brightness() {
	local pct=$1 max
	[ -n "$pct" ] && [ -w "$BL/brightness" ] || return 0
	max=$(cat "$BL/max_brightness" 2>/dev/null) || return 0
	case "$pct" in *[!0-9]*) return 0 ;; esac
	[ "$pct" -lt 1 ] && pct=1
	[ "$pct" -gt 100 ] && pct=100
	echo $((max * pct / 100)) > "$BL/brightness"
}

start_service() {
	local enabled mode interval rotate brightness theme ox oy dim_after dim_level off_after rot_flag=""

	config_load utr-lcd
	config_get_bool enabled main enabled 1
	[ "$enabled" -eq 1 ] || return 0
	config_get mode       main mode auto
	config_get interval   main interval 3
	config_get rotate     main rotate 180
	config_get brightness main brightness ''
	config_get theme      main theme blue
	config_get ox         main offset_x 0
	config_get oy         main offset_y 0
	config_get dim_after  main dim_after 0
	config_get dim_level  main dim_level 15
	config_get off_after  main screen_timeout 0

	[ -e /dev/dri/card0 ] || { logger -t utr-lcd "no /dev/dri/card0 (LCD panel driver missing?)"; return 1; }
	[ "$rotate" = 0 ] && rot_flag="-0"

	mkdir -p "$RUN"
	set_brightness "$brightness"
	# a restart must never leave the panel dark (the power manager may have turned it off)
	[ "$(cat $BL/brightness 2>/dev/null)" = 0 ] && cat "$BL/max_brightness" > "$BL/brightness" 2>/dev/null

	[ "$mode" = auto ] && mode=stock
	if [ "$mode" = stock ] && [ ! -x "$STOCK/bin/ulcmd" ]; then
		# bundle not installed: the built-in renderer needs nothing else, so use it
		logger -t utr-lcd "stock bundle not installed, using the built-in renderer"
		mode=native
	fi

	if [ "$mode" = stock ]; then
		rm -f /var/run/ubus.sock

		procd_open_instance ubusd
		procd_set_param command /sbin/ubusd -s /var/run/ubus.sock
		procd_set_param respawn 3600 5 0
		procd_close_instance

		procd_open_instance ulcmd
		procd_set_param command $LIBEXEC/stock-run.sh
		procd_set_param env UTR_STOCK=$STOCK UTR_RUN=$RUN
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param respawn 3600 5 0
		procd_close_instance

		procd_open_instance fb2drm
		procd_set_param command /usr/bin/utr-lcd-fb2drm -f $RUN/fb0.raw -x "$ox" -y "$oy" $rot_flag
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param respawn 3600 5 0
		procd_close_instance

		procd_open_instance feed
		procd_set_param command $LIBEXEC/feed.sh
		procd_set_param env UTR_RUN=$RUN UTR_LIBEXEC=$LIBEXEC UTR_THEME=$theme UTR_INTERVAL=$interval UTR_BRIGHTNESS=$brightness
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param respawn 3600 5 0
		procd_close_instance

	else
		procd_open_instance native
		procd_set_param command /usr/bin/utr-lcd-status -c $LIBEXEC/collect.sh -i "$interval" $rot_flag
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param respawn 3600 5 0
		procd_close_instance
	fi

	# dim / blank on idle, wake on motion (both modes; only touches the backlight)
	if [ "$dim_after" -gt 0 ] 2>/dev/null || [ "$off_after" -gt 0 ] 2>/dev/null; then
		local full=$brightness
		[ -n "$full" ] || { [ "$mode" = stock ] && full=80 || full=100; }   # the stock UI starts at 80
		procd_open_instance power
		procd_set_param command $LIBEXEC/power.sh
		procd_set_param env UTR_RUN=$RUN UTR_FULL=$full UTR_DIM_AFTER=$dim_after \
			UTR_DIM_LEVEL=$dim_level UTR_OFF_AFTER=$off_after
		procd_set_param respawn 3600 5 0
		procd_close_instance
	fi
}

service_triggers() {
	procd_add_reload_trigger utr-lcd
}
