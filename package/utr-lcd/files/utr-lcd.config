config utr-lcd 'main'
	option enabled '1'
	# auto = stock-style UI if the stock bundle is installed, otherwise the built-in renderer
	# native = always the built-in renderer; stock = require the stock bundle
	option mode 'auto'
	# seconds between status refreshes
	option interval '3'
	# panel rotation: 180 (UTR-LR is mounted upside down) or 0
	option rotate '180'
	# backlight in percent (1-100); leave empty to not touch it
	option brightness ''
	# stock mode only: blue aqua green pink yellow orange purple
	option theme 'blue'
	# stock mode only: placement of the 135x240 image inside the 136x240 panel
	option offset_x '2'
	option offset_y '0'
	# seconds without motion before the backlight dims (0 = never dim)
	option dim_after '0'
	# backlight percent while dimmed
	option dim_level '15'
	# seconds without motion before the backlight turns off (0 = never); motion wakes it again
	option screen_timeout '0'
	# how much the router has to move to count as motion, in milli-g (1000 = 1 g); sensor noise is about 6-15
	option motion_threshold '50'
	# accelerometer sampling rate in Hz while dimming is active (1 12 25 50 100 200; 0 = leave it alone)
	option sensor_rate '25'
	# built-in renderer, several screens: rotate through them in playlist order, or pin one
	option screen_mode 'rotate'
	# pinned screen number (1 = first screen below), used when screen_mode is pin
	option screen_pin '1'
	# order of rotation by screen number, e.g. '1 2 1 3' shows screen 1 twice per round; empty = every enabled screen
	option playlist ''
	# Wi-Fi signal backfill: brightness in percent of the full colour, and a bright line at the fill's edge
	option fill_dim '30'
	option fill_edge '1'
	# client names on traffic screens are cut to this many characters (3-16)
	option name_len '8'

# Screens of the built-in renderer, in order. dwell is seconds on screen (0.5 or more); spacing is the gap between
# widgets in px, or auto to spread the spare room; bars is the Wi-Fi signal as ascending bars (16 24 32);
# indicator: dot, pill or none; backfill: signal fill behind the screen (Wi-Fi uplink only);
# widgets, top to bottom, as type:size: ssid dbm bars dot clients (sizes 16 24 32), wanip lanip vpn uptime (12 16), rule;
# widgets joined by + share one line (max three), e.g. 'dot:16+clients:24';
# traffic: speed (16 24), speedbar usagebar (8 12 16), usage (12 16), legend legendtotal (size = client rows), donut (size = diameter);
# resources: cpu ram flash temp (12 16).
config screen
	option name 'Status'
	option dwell '8'
	option spacing 'auto'
	option enabled '1'
	option indicator 'dot'
	option backfill '1'
	list widget 'ssid:24'
	list widget 'dbm:32'
	list widget 'clients:24'

config screen
	option name 'Traffic'
	option dwell '8'
	option spacing 'auto'
	option enabled '1'
	option indicator 'dot'
	option backfill '1'
	list widget 'speed:24'
	list widget 'speedbar:12'
	list widget 'usage:16'
	list widget 'usagebar:12'
	list widget 'legend:4'

config screen
	option name 'Details'
	option dwell '5'
	option spacing 'auto'
	option enabled '1'
	option indicator 'dot'
	option backfill '1'
	list widget 'wanip:16'
	list widget 'lanip:16'
	list widget 'vpn:16'
	list widget 'uptime:16'
	list widget 'cpu:16'
	list widget 'ram:16'
	list widget 'flash:16'
	list widget 'temp:16'
